{
  "name": "@json-to-office/jto-ops",
  "version": "1.5.0",
  "description": "JSON to Office host operations - format adapters, LibreOffice rasterizer and font staging, free of terminal dependencies",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:ground-truth": "vitest run --config vitest.harness.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "prepublishOnly": "node ../../scripts/copy-license.cjs"
  },
  "dependencies": {
    "@json-to-office/core-docx": "workspace:^",
    "@json-to-office/core-pptx": "workspace:^",
    "@json-to-office/quality": "workspace:^",
    "@json-to-office/shared": "workspace:^",
    "@json-to-office/shared-docx": "workspace:^",
    "@json-to-office/shared-pptx": "workspace:^",
    "koffi": "^2.16.1"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "tsup": "8.5.0",
    "typescript": "5.3.3",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Paolo Barbato",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wiseair-srl/json-to-office.git",
    "directory": "packages/jto-ops"
  },
  "homepage": "https://github.com/Wiseair-srl/json-to-office/tree/main/packages/jto-ops",
  "bugs": {
    "url": "https://github.com/Wiseair-srl/json-to-office/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "json-to-office",
    "typescript",
    "docx",
    "pptx",
    "libreoffice",
    "fonts"
  ]
}
