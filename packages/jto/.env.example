# Server
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# API authentication. Production defaults to "required"; development to
# "auto". Use "disabled" only for an intentionally public/local deployment.
API_AUTH_MODE=auto
API_KEY=
API_KEY_HEADER=x-api-key

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY_HEADERS=false

# Request limits
MAX_REQUEST_BODY_SIZE=33554432
MAX_CONCURRENT_REQUESTS=64

# Remote asset policy. Production defaults to safe. In safe mode every remote
# host must be explicitly allowlisted; private/local addresses remain blocked.
OUTBOUND_SOURCE_MODE=development
OUTBOUND_HOST_ALLOWLIST=

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# LibreOffice integration (optional — for PDF conversion)
LIBREOFFICE_PATH=
LIBREOFFICE_TIMEOUT_MS=30000

# Highcharts export server (optional)
HIGHCHARTS_SERVER_URL=
HIGHCHARTS_API_KEY=
HIGHCHARTS_API_KEY_HEADER=x-api-key

# Remote PPTX rasterizer for DOCX visual components (optional; without a URL,
# the CLI uses local LibreOffice + poppler). For jto-render-server, both keys
# normally carry the same RENDER_API_KEY value.
JTO_PPTX_RASTERIZER_URL=
JTO_PPTX_RASTERIZER_API_KEY=
JTO_PPTX_RASTERIZER_API_KEY_HEADER=x-api-key

# Cache
CACHE_ENABLED=true
CACHE_MAX_SIZE_MB=100
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=1000
