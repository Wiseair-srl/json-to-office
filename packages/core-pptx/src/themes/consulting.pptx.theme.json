{
  "name": "consulting",
  "displayName": "Consulting House",
  "description": "The house style for decision decks — near-black ink, three greys and one deep-blue accent, Calibri body under Arial headings, hairline rules, no fills behind text, safe fonts only",
  "version": "1.0.0",
  "colors": {
    "primary": "#1A1F26",
    "secondary": "#4B5563",
    "accent": "#1B4F8A",
    "background": "#FFFFFF",
    "text": "#1A1F26",
    "text2": "#4B5563",
    "background2": "#F2F4F7",
    "accent4": "#5B8DC9",
    "accent5": "#A9C4E4",
    "accent6": "#7B8794"
  },
  "palette": {
    "rule": "#C9CED6",
    "textMuted": "#7B8794",
    "onPrimary": "#FFFFFF",
    "surfaceInverse": "#1A1F26",
    "positive": "#1E7F4F",
    "negative": "#B42318",
    "chart": ["accent", "secondary", "accent4", "textMuted", "accent5", "rule"]
  },
  "fonts": {
    "heading": "Arial",
    "body": "Calibri",
    "mono": "Consolas"
  },
  "defaults": {
    "fontSize": 14,
    "fontColor": "#1A1F26"
  },
  "styles": {
    "title": {
      "fontSize": 32,
      "bold": true,
      "fontColor": "text",
      "align": "left"
    },
    "subtitle": {
      "fontSize": 16,
      "fontColor": "text2",
      "align": "left"
    },
    "heading1": {
      "fontSize": 24,
      "bold": true,
      "fontColor": "text"
    },
    "heading2": {
      "fontSize": 18,
      "bold": true,
      "fontColor": "text"
    },
    "heading3": {
      "fontSize": 14,
      "bold": true,
      "fontColor": "text2"
    },
    "body": {
      "fontSize": 14,
      "fontColor": "text"
    },
    "caption": {
      "fontSize": 10,
      "fontColor": "text2"
    }
  },
  "typography": {
    "roles": {
      "eyebrow": {
        "face": "heading",
        "size": 10,
        "weight": 700,
        "case": "upper",
        "tracking": 8,
        "color": "accent"
      },
      "display": {
        "face": "heading",
        "size": 28,
        "weight": 700,
        "color": "primary",
        "lineHeight": 1.1
      },
      "stat": {
        "face": "heading",
        "size": 40,
        "weight": 700,
        "color": "accent",
        "lineHeight": 1
      },
      "quote": {
        "face": "body",
        "size": 18,
        "color": "text2",
        "lineHeight": 1.3
      },
      "label": {
        "face": "body",
        "size": 12,
        "weight": 700,
        "color": "text2"
      },
      "footer": {
        "face": "body",
        "size": 9,
        "color": "text2"
      },
      "tableHeader": {
        "face": "body",
        "size": 12,
        "weight": 700,
        "color": "primary"
      },
      "tableCell": {
        "face": "body",
        "size": 12,
        "color": "text"
      },
      "chartLabel": {
        "face": "body",
        "size": 11,
        "weight": 400,
        "color": "text2"
      },
      "tracker": {
        "face": "body",
        "size": 10,
        "case": "upper",
        "tracking": 6,
        "color": "text2"
      },
      "source": {
        "face": "body",
        "size": 9,
        "color": "text2"
      }
    },
    "scale": {
      "wide169": {
        "base": 14,
        "ratio": 1.2,
        "baselinePt": 2
      },
      "standard43": {
        "base": 14,
        "ratio": 1.2,
        "baselinePt": 2
      }
    }
  },
  "spacing": {
    "basePt": 8,
    "blockGap": {
      "tight": 4,
      "normal": 8,
      "loose": 16
    },
    "canvas": {
      "wide169": {
        "safeAreaIn": 0.5,
        "gutterIn": 0.2,
        "columns": 12,
        "rows": 8
      },
      "standard43": {
        "safeAreaIn": 0.5,
        "gutterIn": 0.2,
        "columns": 12,
        "rows": 8
      }
    }
  },
  "chrome": {
    "runningHead": {
      "type": "tracker",
      "color": "text2",
      "rule": {
        "weightPt": 0.5,
        "color": "rule"
      },
      "alignment": "right"
    },
    "tracker": {
      "type": "tracker",
      "color": "text2",
      "alignment": "right"
    },
    "actionTitle": {
      "type": "display",
      "color": "primary"
    },
    "keyTakeaways": {
      "type": "label",
      "color": "primary",
      "rule": {
        "weightPt": 2,
        "color": "accent"
      },
      "padPt": 8
    },
    "sourceLine": {
      "type": "source",
      "color": "text2"
    },
    "confidentialFooter": {
      "type": "footer",
      "color": "text2",
      "rule": {
        "weightPt": 0.5,
        "color": "rule"
      },
      "alignment": "left"
    },
    "logoSlot": {
      "alignment": "right"
    },
    "cover": {
      "type": "display",
      "color": "primary",
      "rule": {
        "weightPt": 3,
        "color": "accent"
      }
    }
  },
  "motif": {
    "kind": "rule",
    "color": "accent",
    "weightPt": 3,
    "placement": "top"
  },
  "componentDefaults": {
    "table": {
      "border": {
        "type": "solid",
        "pt": 0.5,
        "color": "#C9CED6"
      },
      "headerRow": true,
      "fontSize": 12
    },
    "chart": {
      "showLegend": true,
      "legendPos": "b",
      "legendFontSize": 11,
      "catAxisLabelFontSize": 11,
      "valAxisLabelFontSize": 11,
      "catGridLine": {
        "style": "none"
      },
      "valGridLine": {
        "style": "solid",
        "size": 0.5,
        "color": "#E4E7EB"
      },
      "valAxisLineShow": false
    }
  }
}
