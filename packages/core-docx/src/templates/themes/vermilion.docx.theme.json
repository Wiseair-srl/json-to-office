{
  "name": "vermilion",
  "displayName": "Vermilion Editorial",
  "description": "Poster-red editorial system — vermilion display headings, ink text, warm creams and hairline rules",
  "version": "1.0.0",
  "colors": {
    "primary": "#282829",
    "secondary": "#58595B",
    "accent": "#EF4130",
    "text": "#282829",
    "background": "#FFFFFF",
    "border": "#E8E2DC",
    "textPrimary": "#282829",
    "textSecondary": "#58595B",
    "textMuted": "#939598",
    "borderPrimary": "#C7C8CA",
    "borderSecondary": "#EFEAE4",
    "backgroundPrimary": "#FFFFFF",
    "backgroundSecondary": "#FAF7F5"
  },
  "fonts": {
    "heading": {
      "family": "Arial",
      "size": 24
    },
    "body": {
      "family": "Calibri",
      "size": 10.5
    },
    "mono": {
      "family": "Courier New",
      "size": 10
    },
    "light": {
      "family": "Arial",
      "size": 24
    }
  },
  "page": {
    "size": "A4",
    "margins": {
      "top": 1360,
      "bottom": 1360,
      "left": 1180,
      "right": 1180,
      "header": 620,
      "footer": 620,
      "gutter": 0
    }
  },
  "styles": {
    "normal": {
      "font": "body",
      "color": "textPrimary",
      "lineSpacing": {
        "type": "multiple",
        "value": 1.3
      },
      "alignment": "left",
      "spacing": {
        "after": 8
      }
    },
    "heading1": {
      "font": "heading",
      "size": 25,
      "bold": false,
      "color": "accent",
      "characterSpacing": {
        "type": "expanded",
        "value": 50
      },
      "spacing": {
        "before": 22,
        "after": 12
      },
      "keepNext": true,
      "alignment": "left"
    },
    "heading2": {
      "font": "heading",
      "size": 12.5,
      "bold": true,
      "color": "accent",
      "characterSpacing": {
        "type": "expanded",
        "value": 30
      },
      "spacing": {
        "before": 16,
        "after": 7
      },
      "keepNext": true,
      "alignment": "left"
    },
    "heading3": {
      "font": "body",
      "size": 11,
      "bold": true,
      "color": "textPrimary",
      "spacing": {
        "before": 12,
        "after": 5
      },
      "keepNext": true,
      "alignment": "left"
    },
    "heading4": {
      "font": "body",
      "size": 10.5,
      "bold": true,
      "color": "textSecondary",
      "spacing": {
        "before": 10,
        "after": 4
      },
      "keepNext": true,
      "alignment": "left"
    },
    "heading5": {
      "font": "body",
      "size": 10.5,
      "bold": false,
      "italic": true,
      "color": "textSecondary",
      "spacing": {
        "before": 9,
        "after": 4
      },
      "keepNext": true,
      "alignment": "left"
    },
    "heading6": {
      "font": "body",
      "size": 10,
      "bold": true,
      "color": "textMuted",
      "characterSpacing": {
        "type": "expanded",
        "value": 30
      },
      "spacing": {
        "before": 9,
        "after": 4
      },
      "keepNext": true,
      "alignment": "left"
    },
    "title": {
      "font": "heading",
      "size": 38,
      "bold": true,
      "color": "primary",
      "alignment": "left",
      "spacing": {
        "before": 0,
        "after": 14
      }
    },
    "subtitle": {
      "font": "body",
      "size": 14,
      "color": "textSecondary",
      "alignment": "left",
      "spacing": {
        "before": 0,
        "after": 10
      }
    }
  },
  "componentDefaults": {
    "table": {
      "width": 100,
      "borderColor": "#C7C8CA",
      "borderSize": 0.5,
      "hideBorders": {
        "top": true,
        "left": true,
        "right": true,
        "insideVertical": true
      },
      "cellDefaults": {
        "font": { "size": 9.5 },
        "padding": { "top": 7, "bottom": 7 },
        "verticalAlignment": "middle"
      },
      "headerCellDefaults": {
        "color": "#EF4130",
        "font": { "size": 9.5, "bold": true },
        "padding": { "top": 0, "bottom": 8 },
        "verticalAlignment": "bottom",
        "borderColor": { "bottom": "#EF4130" },
        "borderSize": { "bottom": 0.5 }
      }
    },
    "list": {
      "format": "bullet",
      "bullet": "—",
      "spacing": { "item": 2 }
    },
    "image": {
      "alignment": "center"
    },
    "statistic": {
      "alignment": "center"
    },
    "section": {
      "pageBreak": false
    }
  }
}
