            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "02\t**Priority**",
            "font": {
              "size": 11.5,
              "color": "secondary"
            },
            "boldColor": "primary",
            "tabStops": [
              {
                "type": "left",
                "position": 720
              }
            ],
            "spacing": {
              "before": 0,
              "after": 3
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "The core idea should be visible in under ten seconds; detail can reward a second pass.",
            "font": {
              "size": 9.5,
              "color": "#434440"
            },
            "indent": {
              "left": 720
            },
            "spacing": {
              "before": 0,
              "after": 0
            }
          }
        },
        {
          "name": "divider",
          "props": {
            "color": "borderPrimary",
            "thickness": 0.5,
            "spacing": {
              "before": 8,
              "after": 8
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "03\t**Voice**",
            "font": {
              "size": 11.5,
              "color": "secondary"
            },
            "boldColor": "primary",
            "tabStops": [
              {
                "type": "left",
                "position": 720
              }
            ],
            "spacing": {
              "before": 0,
              "after": 3
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "Calm, exact and generous. Never decorative for its own sake.",
            "font": {
              "size": 9.5,
              "color": "#434440"
            },
            "indent": {
              "left": 720
            },
            "spacing": {
              "before": 0,
              "after": 0
            }
          }
        },
        {
          "name": "divider",
          "props": {
            "color": "borderPrimary",
            "thickness": 0.5,
            "spacing": {
              "before": 8,
              "after": 8
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "04\t**Contrast**",
            "font": {
              "size": 11.5,
              "color": "secondary"
            },
            "boldColor": "primary",
            "tabStops": [
              {
                "type": "left",
                "position": 720
              }
            ],
            "spacing": {
              "before": 0,
              "after": 3
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "Use one strong contrast at a time: scale, weight, spacing or colour — not all four.",
            "font": {
              "size": 9.5,
              "color": "#434440"
            },
            "indent": {
              "left": 720
            },
            "spacing": {
              "before": 0,
              "after": 0
            }
          }
        },
        {
          "name": "divider",
          "props": {
            "color": "borderPrimary",
            "thickness": 0.5,
            "spacing": {
              "before": 8,
              "after": 8
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "05\t**Restraint**",
            "font": {
              "size": 11.5,
              "color": "secondary"
            },
            "boldColor": "primary",
            "tabStops": [
              {
                "type": "left",
                "position": 720
              }
            ],
            "spacing": {
              "before": 0,
              "after": 3
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "Leave enough unclaimed space that the important material can breathe.",
            "font": {
              "size": 9.5,
              "color": "#434440"
            },
            "indent": {
              "left": 720
            },
            "spacing": {
              "before": 0,
              "after": 0
            }
          }
        },
        {
          "name": "divider",
          "props": {
            "color": "borderPrimary",
            "thickness": 0.5,
            "spacing": {
              "before": 8,
              "after": 8
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "The point is not to eliminate taste. It is to give taste a structure. A team can disagree productively when the brief names the trade-offs in advance.",
            "font": {
              "italic": true
            },
            "spacing": {
              "before": 12,
              "after": 0
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "EDITING PASS",
            "pageBreak": true,
            "font": {
              "size": 8,
              "bold": true,
              "color": "secondary",
              "characterSpacing": {
                "type": "expanded",
                "value": 24
              }
            },
            "spacing": {
              "before": 0,
              "after": 16
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "Remove until\nmeaning gets louder",
            "themeStyle": "title",
            "font": {
              "size": 27
            }
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "A polished result often comes from subtraction, but not arbitrary minimalism. Remove elements only when their absence increases hierarchy, comprehension or mood.",
            "themeStyle": "subtitle",
            "font": {
              "size": 11
            }
          }
        },
