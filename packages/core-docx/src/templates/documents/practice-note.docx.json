          "children": [
            {
              "name": "paragraph",
              "props": {
                "text": "Keep one hero",
                "font": {
                  "size": 13,
                  "bold": true,
                  "color": "primary"
                },
                "spacing": {
                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Every page needs one dominant element. If two things ask for first attention, decide which one wins.",
                "font": {
                  "size": 9.5,
                  "color": "#434440"
                },
                "spacing": {
                  "before": 0,
