                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Consistency should be felt before it is noticed. Reuse spacing, alignment and text roles with discipline.",
                "font": {
                  "size": 9.5,
                  "color": "#434440"
                },
                "spacing": {
                  "before": 0,
