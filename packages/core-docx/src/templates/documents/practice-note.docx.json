        {
          "name": "paragraph",
          "props": {
            "text": "The quiet\nbrief",
            "themeStyle": "title"
          }
        },
        {
          "name": "paragraph",
          "props": {
            "text": "How to make a project feel calmer, clearer and more intentional before a single visual decision is made.",
            "themeStyle": "subtitle"
          }
        },
        {
