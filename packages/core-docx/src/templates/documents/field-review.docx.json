            "columns": 2,
            "gap": 21
          },
          "children": [
            {
              "name": "paragraph",
              "props": {
                "text": "PATTERN 01  /  THE ALL-DAY BLOCK",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 0,
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "From occupancy\nto usefulness",
                "themeStyle": "title",
                "font": {
                  "size": 23
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "A building can be full and still underperform. The more revealing measure is the number of distinct reasons people have to enter, stay and return.",
                "themeStyle": "subtitle"
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "MORNING",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 2,
                  "after": 6
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Fast coffee, school drop-off, focused work and short appointments reward visible entrances, frictionless service and strong daylight."
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "MIDDAY",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 6,
                  "after": 6
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "The dominant need shifts to convenience: lunch, quick retail, informal meetings and places that allow a 30-minute reset without a reservation."
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "EVENING",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 6,
                  "after": 6
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "A district earns resilience when it converts naturally into leisure. Lighting, food, fitness and cultural programming should feel intentional rather than residual.",
                "spacing": {
                  "after": 10
                }
              }
            },
            {
              "name": "text-box",
              "props": {
                "width": "100%",
                "style": {
                  "padding": {
                    "top": 8,
                    "right": 12,
                    "bottom": 8,
                    "left": 12
                  },
                  "border": {
                    "left": {
                      "style": "solid",
                      "width": 2.25,
                      "color": "secondary"
                    },
                    "top": {
                      "style": "none"
                    },
                    "bottom": {
                      "style": "none"
                    },
                    "right": {
                      "style": "none"
                    }
                  },
                  "shading": {
                    "fill": "#F2F3F3"
                  }
                }
              },
              "children": [
                {
                  "name": "paragraph",
                  "props": {
                    "text": "Design the handoff between uses, not only the uses themselves.",
                    "font": {
                      "size": 10.5,
                      "bold": true,
                      "color": "textPrimary",
                      "lineSpacing": {
                        "type": "multiple",
                        "value": 1.25
                      }
                    },
                    "spacing": {
                      "before": 0,
                      "after": 0
                    }
                  }
                }
              ]
            },
            {
              "name": "paragraph",
              "props": {
                "text": "OPERATING NOTE",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "secondary",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 12,
                  "after": 6
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "The transition moments — 8:30, 12:30, 18:00 — often expose the weak points in circulation, staffing and atmosphere.",
                "spacing": {
                  "after": 0
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "A SIMPLE SCORECARD",
                "columnBreak": true,
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 0,
                  "after": 8
                }
              }
            },
            {
              "name": "table",
              "props": {
                "hideBorders": true,
                "cellDefaults": {
                  "borderSize": 0
                },
                "columns": [
                  {
                    "width": 62,
