      "children": [
        {
          "name": "columns",
          "props": {
            "columns": 2,
            "gap": 21
          },
          "children": [
            {
              "name": "paragraph",
              "props": {
                "text": "PLAYBOOK  /  90 DAYS",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 0,
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Test the district\nbefore redesigning it",
                "themeStyle": "title",
                "font": {
                  "size": 23
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Small operational experiments reveal more than large speculative plans. Use a quarter to test demand, then lock the winning behaviours into the permanent brief.",
                "themeStyle": "subtitle",
                "spacing": {
                  "after": 14
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "W01–02   **Observe**",
                "font": {
                  "size": 12.5,
                  "color": "accent"
                },
                "boldColor": "primary",
                "spacing": {
                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Map footfall by hour, note dwell points, record queues and identify “dead” transitions between uses.",
                "font": {
                  "size": 8.5
                },
                "spacing": {
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "W03–05   **Prototype**",
                "font": {
                  "size": 12.5,
                  "color": "accent"
                },
                "boldColor": "primary",
                "spacing": {
                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Add movable seating, power, shade, pop-up retail or a programmed event. Change one variable at a time.",
                "font": {
                  "size": 8.5
                },
                "spacing": {
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "W06–09   **Measure**",
                "font": {
                  "size": 12.5,
                  "color": "accent"
                },
                "boldColor": "primary",
                "spacing": {
                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Track repeat visits, duration and conversion. Pair counts with short intercept interviews to explain behaviour.",
                "font": {
                  "size": 8.5
                },
                "spacing": {
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "W10–12   **Codify**",
                "font": {
                  "size": 12.5,
                  "color": "accent"
                },
                "boldColor": "primary",
                "spacing": {
                  "before": 0,
                  "after": 3
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Translate the strongest tests into design requirements, service standards and a simple weekly operating calendar.",
                "font": {
                  "size": 8.5
                },
                "spacing": {
                  "after": 0
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "WHAT TO PROTECT",
                "columnBreak": true,
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 0,
                  "after": 6
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "Do not over-program every square metre. The most valued urban spaces retain a degree of ambiguity: they invite people to appropriate them without asking permission.",
                "spacing": {
                  "after": 10
                }
              }
            },
            {
              "name": "paragraph",
              "props": {
                "text": "CLOSING THOUGHT",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 0,
                  "after": 6
                }
              }
            },
            {
              "name": "text-box",
              "props": {
                "width": "100%",
                "style": {
                  "padding": {
                    "top": 8,
                    "right": 12,
                    "bottom": 8,
                    "left": 12
                  },
                  "border": {
                    "left": {
                      "style": "solid",
                      "width": 2.25,
                      "color": "accent"
                    },
                    "top": {
                      "style": "none"
                    },
                    "bottom": {
                      "style": "none"
                    },
                    "right": {
                      "style": "none"
                    }
                  },
                  "shading": {
                    "fill": "backgroundSecondary"
                  }
                }
              },
              "children": [
                {
                  "name": "paragraph",
                  "props": {
                    "text": "Useful places feel specific in character and flexible in use.",
                    "font": {
                      "size": 10.5,
                      "bold": true,
                      "color": "textPrimary",
                      "lineSpacing": {
                        "type": "multiple",
                        "value": 1.25
                      }
                    },
                    "spacing": {
