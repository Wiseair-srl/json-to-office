              "props": {
                "text": "DECISION FILTER",
                "font": {
                  "size": 8,
                  "bold": true,
                  "color": "accent",
                  "characterSpacing": {
                    "type": "expanded",
                    "value": 20
                  }
                },
                "spacing": {
                  "before": 12,
                  "after": 6
                }
              }
            },
            {
