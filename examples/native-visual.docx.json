{
  "name": "docx",
  "renderer": "office-open",
  "props": {
    "metadata": {
      "title": "Q2 Operating Review",
      "author": "Meridian Industries",
      "description": "Report with a natively drawn Word drawing group"
    },
    "theme": "vermilion"
  },
  "children": [
    {
      "name": "section",
      "props": {
        "meta": {
          "title": "Native infographic"
        }
